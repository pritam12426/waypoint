# Port the Rust waypointd server is listening on in dev.
# Read by vite.config.ts to configure the /api, /keywords, /open proxy.
WAYPOINTD_SERVE_PORT=8080

# Only needed if you want the built SPA to call an absolute API origin
# instead of same-origin relative paths (e.g. deploying frontend and
# backend separately). Leave unset for the normal same-origin setup.
# VITE_API_BASE=https://waypointd.example.com
